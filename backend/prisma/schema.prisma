generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RIDER
  DRIVER
  ADMIN
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverAvailability {
  OFFLINE
  ONLINE
  ON_TRIP
}

enum RegistrationStatus {
  NIN_PENDING
  PROFILE_PENDING
  DOCUMENTS_PENDING
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

enum RideStatus {
  REQUESTED
  SEARCHING
  MATCHED
  DRIVER_EN_ROUTE
  ARRIVED
  PIN_CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVER
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum DocType {
  DRIVERS_LICENSE
  POLICE_CLEARANCE
  DSS_CLEARANCE
  SELFIE
  OTHER
}

model User {
  id                 String             @id @default(cuid())
  phone              String             @unique
  email              String?
  name               String
  passwordHash       String
  role               UserRole           @default(RIDER)
  nin                String?
  ninVerified        Boolean            @default(false)
  dob                String?
  address            String?
  selfieUrl          String?            @db.Text
  registrationStatus RegistrationStatus @default(NIN_PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  driverProfile Driver?
  ridesAsRider  Ride[]           @relation("RiderRides")
  wallet        Wallet?
  ratingsGiven  Rating[]         @relation("Rater")
  ratingsRecv   Rating[]         @relation("Ratee")
  documents     Document[]
  sosEvents     SosEvent[]
  recordings    SafetyRecording[]
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType   DocType
  fileData  String   @db.Text
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, docType])
}

model Driver {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNo      String?
  status         DriverStatus       @default(PENDING)
  availability   DriverAvailability @default(OFFLINE)
  rating         Float              @default(5)
  isOnline       Boolean            @default(false)
  lat            Float?
  lng            Float?
  heading        Float?
  lastHeartbeat  DateTime?
  pushToken      String?
  updatedAt      DateTime           @updatedAt
  vehicles       Vehicle[]
  rides          Ride[]
  offers         RideOffer[]
}

model Vehicle {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  make     String
  model    String
  plate    String
  category String @default("ECONOMY")
}

model Ride {
  id                 String     @id @default(cuid())
  riderId            String
  rider              User       @relation("RiderRides", fields: [riderId], references: [id])
  driverId           String?
  driver             Driver?    @relation(fields: [driverId], references: [id])
  originLat          Float
  originLng          Float
  destLat            Float
  destLng            Float
  originLabel        String?
  destLabel          String?
  category           String     @default("ECONOMY")
  status             RideStatus @default(SEARCHING)
  fareEstimate       Float?
  fareFinal          Float?
  distanceKm         Float?
  durationMin        Float?
  searchRadiusKm     Float      @default(5)
  dispatchRound      Int        @default(0)
  polyline           String?    @db.Text
  pickupPinHash      String?
  pickupPinPlain     String?
  pinRevealedAt      DateTime?
  riderPinConfirmed  Boolean    @default(false)
  driverPinConfirmed Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  payment            Payment?
  ratings            Rating[]
  sosEvents          SosEvent[]
  recordings         SafetyRecording[]
  offers             RideOffer[]
}

model RideOffer {
  id           String      @id @default(cuid())
  rideId       String
  ride         Ride        @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driverId     String
  driver       Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  status       OfferStatus @default(PENDING)
  offeredAt    DateTime    @default(now())
  expiresAt    DateTime
  respondedAt  DateTime?

  @@index([driverId, status])
  @@index([rideId, status])
  @@index([expiresAt])
}

model Payment {
  id         String   @id @default(cuid())
  rideId     String   @unique
  ride       Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  amount     Float
  method     String
  status     String   @default("PENDING")
  gatewayRef String?
  createdAt  DateTime @default(now())
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  currency  String   @default("NGN")
  updatedAt DateTime @updatedAt
}

model Rating {
  id        String   @id @default(cuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User     @relation("Rater", fields: [raterId], references: [id])
  rateeId   String
  ratee     User     @relation("Ratee", fields: [rateeId], references: [id])
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}

model SosEvent {
  id        String   @id @default(cuid())
  rideId    String?
  ride      Ride?    @relation(fields: [rideId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat       Float?
  lng       Float?
  silent    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SafetyRecording {
  id        String   @id @default(cuid())
  rideId    String?
  ride      Ride?    @relation(fields: [rideId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
